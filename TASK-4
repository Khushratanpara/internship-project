import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score

data_link = "https://raw.githubusercontent.com/ShuklaPrashant21/Used-Car-Price-Prediction/master/car%20data.csv"
data = pd.read_csv(data_link)

print("Shape of data (rows, columns):", data.shape)
print("\nFirst 5 rows of data:")
print(data.head())


data = data.drop_duplicates()

current_year = 2026
data["Car_Age"] = current_year - data["Year"]
data = data.drop(columns=["Year", "Car_Name"])  
data = pd.get_dummies(data, columns=["Fuel_Type", "Seller_Type", "Transmission"], drop_first=True)

x = data.drop(columns=["Selling_Price"])
y = data["Selling_Price"]

print("\nCorrelation of main factors with Selling_Price:")
print(data[["Present_Price", "Kms_Driven", "Car_Age", "Owner", "Selling_Price"]].corr()["Selling_Price"].sort_values(ascending=False))

x_train, x_test, y_train, y_test = train_test_split(x, y, test_size=0.2, random_state=42)
model = LinearRegression()
model.fit(x_train, y_train)
y_pred = model.predict(x_test)

mae = mean_absolute_error(y_test, y_pred)
rmse = np.sqrt(mean_squared_error(y_test, y_pred))
r2 = r2_score(y_test, y_pred)

print("\nModel Performance on test data:")
print("Mean Absolute Error (MAE):", round(mae, 2))
print("Root Mean Squared Error (RMSE):", round(rmse, 2))
print("R2 Score:", round(r2, 2), "  (closer to 1 is better)")

coef_data = pd.DataFrame({"Factor": x.columns, "Effect_on_Price": model.coef_})
coef_data = coef_data.sort_values(by="Effect_on_Price", ascending=False)
print("\nHow much each factor affects selling price (coefficients):")
print(coef_data)

new_cars = pd.DataFrame(0, index=[0, 1, 2], columns=x.columns)
new_cars["Present_Price"] = [5.5, 9.0, 3.0]
new_cars["Kms_Driven"] = [30000, 15000, 60000]
new_cars["Car_Age"] = [5, 2, 8]
new_cars["Owner"] = [0, 0, 1]
if "Fuel_Type_Petrol" in new_cars.columns:
    new_cars["Fuel_Type_Petrol"] = [1, 0, 1]
if "Transmission_Manual" in new_cars.columns:
    new_cars["Transmission_Manual"] = [1, 1, 1]

new_cars["Predicted_Selling_Price"] = model.predict(new_cars[x.columns]).round(2)
print("\nPredicted selling price for sample used cars (in lakhs):")
print(new_cars[["Present_Price", "Kms_Driven", "Car_Age", "Owner", "Predicted_Selling_Price"]])

plt.figure(figsize=(6, 5))
plt.scatter(y_test, y_pred, color="darkgreen")
plt.plot([y_test.min(), y_test.max()], [y_test.min(), y_test.max()], color="black", linestyle="--")
plt.xlabel("Actual Selling Price")
plt.ylabel("Predicted Selling Price")
plt.title("Actual vs Predicted Car Selling Price")
plt.tight_layout()
plt.savefig("actual_vs_predicted_price.png")
plt.show()

best_factor = coef_data.iloc[0]["Factor"]
worst_factor = coef_data.iloc[-1]["Factor"]
print("\nInsight:")
print("- '" + best_factor + "' has the strongest positive effect on selling price.")
print("- '" + worst_factor + "' has the strongest negative effect on selling price.")
print("- Model R2 score of", round(r2, 2), "means the model explains about",
      str(round(r2 * 100)) + "%", "of the variation in selling price, which is a good fit.")


